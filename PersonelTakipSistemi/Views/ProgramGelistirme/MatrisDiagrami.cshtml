@{
    ViewData["Title"] = "Matris Diagramı";
}

@section Styles {
    <style>
        .matrix-report {
            --matrix-bg: #ffffff;
            --matrix-fg: #25324b;
            --matrix-muted: #697a8d;
            --matrix-border: #d9dee3;
            --matrix-soft: #f5f5f9;
            --matrix-red: #d92d20;
            --matrix-red-dark: #9f1f18;
            --matrix-blue: #4f8fe8;
            --matrix-blue-dark: #1e63b6;
            --matrix-shadow: 0 0.75rem 2rem rgba(67, 89, 113, 0.12);
            color: var(--matrix-fg);
        }

        .matrix-report-card {
            overflow: hidden;
            background: var(--matrix-bg);
        }

        .matrix-report-header {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--matrix-border);
            background: #fff;
        }

        .matrix-report-stats {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .matrix-report-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: flex-end;
            gap: 0.75rem;
        }

        .matrix-filterbar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.6rem;
        }

        .matrix-filter {
            display: grid;
            gap: 0.2rem;
            min-width: 170px;
        }

        .matrix-filter label {
            margin: 0;
            color: var(--matrix-muted);
            font-size: 0.74rem;
            font-weight: 800;
        }

        .matrix-filter select {
            min-height: 34px;
            border: 1px solid var(--matrix-border);
            border-radius: 0.45rem;
            background-color: #fff;
            color: var(--matrix-fg);
            font-size: 0.84rem;
            font-weight: 700;
        }

        .matrix-stat,
        .matrix-filter-badge {
            display: inline-flex;
            align-items: center;
            min-height: 30px;
            padding: 0.25rem 0.65rem;
            border-radius: 0.45rem;
            background: var(--matrix-soft);
            color: #566a7f;
            font-size: 0.8125rem;
            font-weight: 700;
        }

        .matrix-filter-badge {
            max-width: 320px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: var(--matrix-blue-dark);
            background: #eef5ff;
        }

        .matrix-board {
            display: grid;
            grid-template-columns: minmax(360px, 0.78fr) minmax(0, 1.22fr);
            gap: 1rem;
            padding: 1rem;
            align-items: stretch;
        }

        .matrix-panel {
            min-width: 0;
            overflow: hidden;
            border: 1px solid var(--matrix-border);
            border-radius: 0.5rem;
            background: #fff;
            box-shadow: 0 0.35rem 1.2rem rgba(67, 89, 113, 0.08);
        }

        .matrix-panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            min-height: 62px;
            padding: 0.85rem 1rem;
            border-bottom: 1px solid var(--matrix-border);
            background: #fbfcfe;
        }

        .matrix-panel-title {
            margin: 0;
            color: var(--matrix-fg);
            font-size: 1rem;
            font-weight: 800;
        }

        .matrix-panel-subtitle {
            margin-top: 0.15rem;
            color: var(--matrix-muted);
            font-size: 0.78rem;
            font-weight: 600;
        }

        .matrix-panel-tools {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: flex-end;
            gap: 0.6rem;
            min-width: 0;
        }

        .matrix-legend {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            color: var(--matrix-muted);
            font-size: 0.75rem;
            font-weight: 700;
        }

        .matrix-legend-bar {
            width: 96px;
            height: 10px;
            border: 1px solid var(--matrix-border);
            border-radius: 0.25rem;
            background: linear-gradient(90deg, #fff5f0, #fb9272, #c5161d);
        }

        .matrix-panel-body {
            position: relative;
            min-height: 520px;
            overflow-x: hidden;
            overflow-y: auto;
        }

        .network-body {
            min-height: 560px;
        }

        .matrix-body {
            min-height: 560px;
        }

        .matrix-panel svg {
            display: block;
            width: 100%;
            max-width: 100%;
        }

        .matrix-loading {
            display: grid;
            min-height: 520px;
            place-items: center;
            color: #566a7f;
            font-weight: 700;
        }

        .network-node circle {
            cursor: pointer;
            transition: filter 0.16s ease, opacity 0.16s ease;
        }

        .network-node:hover circle,
        .network-node.is-selected circle {
            filter: brightness(1.08);
            stroke-width: 3px;
        }

        .network-node.is-dimmed circle,
        .network-link.is-dimmed {
            opacity: 0.18;
        }

        .network-label {
            pointer-events: none;
            user-select: none;
            font-size: 0.56rem;
            font-weight: 800;
            text-anchor: middle;
        }

        .network-label.ana {
            fill: #fff;
        }

        .network-label.lesson {
            fill: var(--matrix-blue-dark);
        }

        .network-section-title {
            fill: var(--matrix-fg);
            font-size: 0.9rem;
            font-weight: 800;
            text-anchor: middle;
        }

        .network-section-title.ana {
            fill: var(--matrix-red-dark);
        }

        .network-section-title.lesson {
            fill: var(--matrix-blue-dark);
        }

        .network-link-bg {
            fill: none;
            stroke: #b6c2d0;
            stroke-width: 1;
            stroke-dasharray: 4 4;
            opacity: 0.36;
        }

        .network-link {
            fill: none;
            stroke: #263238;
            stroke-width: 2.2;
            opacity: 0.76;
        }

        .network-link.is-highlight {
            stroke-width: 3.2;
            opacity: 1;
        }

        .matrix-axis-title {
            fill: var(--matrix-fg);
            font-size: 0.74rem;
            font-weight: 900;
        }

        .matrix-axis-title.row {
            fill: var(--matrix-red-dark);
        }

        .matrix-axis-title.col {
            fill: var(--matrix-blue-dark);
        }

        .matrix-label {
            fill: var(--matrix-fg);
            font-size: 0.68rem;
            font-weight: 700;
        }

        .matrix-label.row {
            fill: var(--matrix-red-dark);
        }

        .matrix-label.col {
            fill: var(--matrix-blue-dark);
        }

        .matrix-cell rect {
            stroke: rgba(148, 163, 184, 0.85);
            stroke-width: 0.8;
            transition: filter 0.14s ease, stroke-width 0.14s ease;
        }

        .matrix-cell.has-value {
            cursor: pointer;
        }

        .matrix-cell.has-value:hover rect {
            filter: saturate(1.08) brightness(1.03);
            stroke: var(--matrix-blue-dark);
            stroke-width: 1.8;
        }

        .matrix-value {
            pointer-events: none;
            fill: #5f1722;
            font-size: 0.76rem;
            font-weight: 900;
            text-anchor: middle;
        }

        .matrix-value.on-dark {
            fill: #fff;
        }

        .matrix-modal {
            position: fixed;
            inset: 0;
            z-index: 1050;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            background: rgba(15, 23, 42, 0.45);
        }

        .matrix-modal.is-open {
            display: flex;
        }

        .matrix-modal-dialog {
            display: flex;
            flex-direction: column;
            width: min(720px, 100%);
            max-height: min(78vh, 720px);
            overflow: hidden;
            border: 1px solid var(--matrix-border);
            border-radius: 0.65rem;
            background: #fff;
            box-shadow: var(--matrix-shadow);
        }

        .matrix-modal-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 1.1rem;
            border-bottom: 1px solid var(--matrix-border);
        }

        .matrix-modal-title {
            margin: 0;
            color: var(--matrix-fg);
            font-size: 1rem;
            font-weight: 900;
        }

        .matrix-modal-subtitle {
            margin-top: 0.25rem;
            color: var(--matrix-muted);
            font-size: 0.82rem;
            font-weight: 600;
        }

        .matrix-modal-close {
            width: 2rem;
            min-height: 2rem;
            padding: 0;
            border: 1px solid var(--matrix-border);
            border-radius: 0.45rem;
            background: var(--matrix-soft);
            color: var(--matrix-fg);
            font-size: 1.25rem;
            line-height: 1;
        }

        .matrix-modal-body {
            overflow: auto;
            padding: 1rem 1.1rem 1.1rem;
        }

        .matrix-detail-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.84rem;
        }

        .matrix-detail-table th,
        .matrix-detail-table td {
            padding: 0.55rem 0.65rem;
            border: 1px solid var(--matrix-border);
            text-align: left;
            vertical-align: top;
        }

        .matrix-detail-table th {
            background: #f8fafc;
            color: var(--matrix-muted);
            font-size: 0.78rem;
            font-weight: 900;
        }

        .matrix-detail-table tr:nth-child(even) td {
            background: #fbfcfe;
        }

        @@media (max-width: 1399.98px) {
            .matrix-board {
                grid-template-columns: 1fr;
            }

            .network-body,
            .matrix-body {
                min-height: 520px;
            }
        }

        @@media (max-width: 767.98px) {
            .matrix-board {
                padding: 0.75rem;
                gap: 0.75rem;
            }

            .matrix-report-header,
            .matrix-panel-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .matrix-panel-tools {
                justify-content: flex-start;
                width: 100%;
            }

            .matrix-report-actions,
            .matrix-filterbar,
            .matrix-filter,
            .matrix-filter select {
                width: 100%;
            }

            .network-body,
            .matrix-body {
                min-height: 480px;
            }
        }
    </style>
}

<div class="pg-page-title">
    <h4><span class="text-muted fw-light">Program Geliştirme Modülü /</span> <strong>Öğrenci Profili</strong></h4>
</div>

<div class="card pg-summary-card mb-3">
    <div class="card-body pg-summary-body">
        <div>
            <h5 class="pg-summary-title">Matris Diagramı</h5>
            <div id="matrixStatus" class="pg-summary-subtitle">Matris verisi yükleniyor...</div>
        </div>
        <div id="matrixStats" class="matrix-report-stats pg-summary-stats" aria-live="polite"></div>
    </div>
</div>

<div class="card matrix-report matrix-report-card pg-filter-card">
    <div class="matrix-report-header pg-filter-row">
        <div class="matrix-filterbar" aria-label="Matris filtreleri">
            <div class="matrix-filter">
                <label for="matrixCategoryFilter">Kategori</label>
                <select id="matrixCategoryFilter" class="form-select form-select-sm">
                    <option value="">Tümü</option>
                </select>
            </div>
            <div class="matrix-filter">
                <label for="matrixLessonFilter">Ders</label>
                <select id="matrixLessonFilter" class="form-select form-select-sm">
                    <option value="">Tüm dersler</option>
                </select>
            </div>
            <div class="matrix-filter">
                <label for="matrixClassFilter">Sınıf</label>
                <select id="matrixClassFilter" class="form-select form-select-sm">
                    <option value="">Tüm sınıflar</option>
                </select>
            </div>
        </div>
    </div>

    <div class="matrix-board">
        <section class="matrix-panel" id="networkPanel">
            <div class="matrix-panel-header">
                <div>
                    <h5 class="matrix-panel-title">Ağ Diyagramı</h5>
                    <div class="matrix-panel-subtitle">Ana Profiller - Dersler</div>
                </div>
                <button id="matrixClearSelection" type="button" class="btn btn-sm btn-outline-secondary">Temizle</button>
            </div>
            <div class="matrix-panel-body network-body">
                <svg id="profileLessonNetwork" aria-label="Ana profil ve ders ilişkileri"></svg>
            </div>
        </section>

        <section class="matrix-panel" id="matrixPanel">
            <div class="matrix-panel-header">
                <div>
                    <h5 class="matrix-panel-title">İlişki Matrisi</h5>
                    <div class="matrix-panel-subtitle">Temalar - Destekleyici Profiller</div>
                </div>
                <div class="matrix-panel-tools">
                    <span id="matrixFilterBadge" class="matrix-filter-badge">Genel toplam</span>
                    <div class="matrix-legend">
                        <span>0</span>
                        <span class="matrix-legend-bar"></span>
                        <span id="matrixLegendMax">max</span>
                    </div>
                </div>
            </div>
            <div class="matrix-panel-body matrix-body">
                <svg id="themeSupportMatrix" aria-label="Tema ve destekleyici profil matrisi"></svg>
            </div>
        </section>
    </div>

    <div id="matrixLoading" class="matrix-loading">Matris diagramı hazırlanıyor...</div>
</div>

<div id="matrixDetailModal" class="matrix-modal" role="dialog" aria-modal="true" aria-label="Matris detayları">
    <div class="matrix-modal-dialog">
        <div class="matrix-modal-header">
            <div>
                <h5 id="matrixModalTitle" class="matrix-modal-title">Detay</h5>
                <div id="matrixModalSubtitle" class="matrix-modal-subtitle"></div>
            </div>
            <button id="matrixModalClose" class="matrix-modal-close" type="button" aria-label="Kapat">&times;</button>
        </div>
        <div class="matrix-modal-body">
            <table class="matrix-detail-table">
                <thead>
                    <tr>
                        <th>Sınıf</th>
                        <th>Ders</th>
                        <th>Ana Profil</th>
                        <th>Destekleyici Profil</th>
                    </tr>
                </thead>
                <tbody id="matrixModalRows"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ogrenci-profili-store.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>
    <script>
        (() => {
            const dataSourceUrl = `/data/ogrenci_profili_ag_verisi.json?v=${Date.now()}`;
            const profileOrder = ['Vatansever', 'Ahlaklı', 'Bilge', 'Cesaretli', 'Estetik', 'İradeli', 'Merhametli', 'Sağlıklı', 'Sorgulayıcı', 'Üretken'];
            window.addEventListener('storage', event => {
                if (event.key === window.OgrenciProfiliStore.recordsKey || event.key === window.OgrenciProfiliStore.definitionsKey) {
                    window.location.reload();
                }
            });
            const lessonOrder = ['MATEMATİK (TEMEL EĞİTİM)', 'MATEMATİK (ORTAÖĞRETİM)', 'TÜRKÇE', 'FEN BİLİMLERİ', 'SOSYAL BİLGİLER', 'MÜZİK', 'HAYAT BİLGİSİ', 'T.C. İNKILAP TARİHİ VE ATATÜRKÇÜLÜK'];
            const lessonDisplay = new Map([
                ['MATEMATİK (TEMEL EĞİTİM)', 'Matematik T.E.'],
                ['MATEMATİK (ORTAÖĞRETİM)', 'Matematik O.O.'],
                ['TÜRKÇE', 'türkçe'],
                ['FEN BİLİMLERİ', 'fen bilimleri'],
                ['SOSYAL BİLGİLER', 'sosyal bilgiler'],
                ['MÜZİK', 'müzik'],
                ['HAYAT BİLGİSİ', 'hayat bilgisi'],
                ['T.C. İNKILAP TARİHİ VE ATATÜRKÇÜLÜK', 'inkılap tarihi']
            ]);

            const state = {
                allRecords: [],
                records: [],
                profiles: [],
                lessons: [],
                themes: [],
                supportProfiles: [],
                edgeCounts: new Map(),
                filter: null,
                filterType: null,
                filterLabel: 'Genel toplam',
                selectedCategory: '',
                selectedClass: '',
                selectedLesson: ''
            };

            const el = {
                status: document.getElementById('matrixStatus'),
                stats: document.getElementById('matrixStats'),
                loading: document.getElementById('matrixLoading'),
                networkPanel: document.querySelector('#networkPanel .matrix-panel-body'),
                matrixPanel: document.querySelector('#matrixPanel .matrix-panel-body'),
                networkSvg: d3.select('#profileLessonNetwork'),
                matrixSvg: d3.select('#themeSupportMatrix'),
                clear: document.getElementById('matrixClearSelection'),
                categoryFilter: document.getElementById('matrixCategoryFilter'),
                classFilter: document.getElementById('matrixClassFilter'),
                lessonFilter: document.getElementById('matrixLessonFilter'),
                badge: document.getElementById('matrixFilterBadge'),
                legendMax: document.getElementById('matrixLegendMax'),
                modal: document.getElementById('matrixDetailModal'),
                modalClose: document.getElementById('matrixModalClose'),
                modalTitle: document.getElementById('matrixModalTitle'),
                modalSubtitle: document.getElementById('matrixModalSubtitle'),
                modalRows: document.getElementById('matrixModalRows')
            };

            function escapeHtml(value) {
                return String(value ?? '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function uniqueSorted(values) {
                return Array.from(new Set(values.filter(Boolean))).sort((a, b) => a.localeCompare(b, 'tr'));
            }

            function normalizeText(value) {
                return String(value || '').trim();
            }

            function optionMarkup(value, label = value) {
                return `<option value="${escapeHtml(value)}">${escapeHtml(label)}</option>`;
            }

            function categorySortKey(value) {
                if (value === 'Ortaöğretim') return 0;
                if (value === 'Temel Eğitim') return 1;
                if (value === 'Din Öğretimi') return 2;
                return 99;
            }

            function classSortKey(value) {
                const text = normalizeText(value).toLocaleLowerCase('tr-TR');
                if (text.includes('hazırlık') || text.includes('hazirlik')) return 0;
                const match = text.match(/\d+/);
                return match ? parseInt(match[0], 10) : 999;
            }

            function filteredByCategory(records) {
                return state.selectedCategory
                    ? records.filter(record => normalizeText(record.kategori || 'Temel Eğitim') === state.selectedCategory)
                    : records;
            }

            function filteredByLesson(records) {
                const categoryRecords = filteredByCategory(records);
                return state.selectedLesson
                    ? categoryRecords.filter(record => normalizeText(record.ders) === state.selectedLesson)
                    : categoryRecords;
            }

            function filteredRecords() {
                const lessonRecords = filteredByLesson(state.allRecords);
                return state.selectedClass
                    ? lessonRecords.filter(record => normalizeText(record.sinif) === state.selectedClass)
                    : lessonRecords;
            }

            function populateCategoryFilter(records) {
                const categories = uniqueSorted(records.map(record => record.kategori || 'Temel Eğitim'))
                    .sort((a, b) => categorySortKey(a) - categorySortKey(b) || a.localeCompare(b, 'tr'));
                el.categoryFilter.innerHTML = optionMarkup('', 'Tümü') + categories.map(item => optionMarkup(item)).join('');
                el.categoryFilter.value = state.selectedCategory;
            }

            function populateClassFilter(records) {
                const classes = uniqueSorted(filteredByLesson(records).map(record => normalizeText(record.sinif)))
                    .sort((a, b) => classSortKey(a) - classSortKey(b) || a.localeCompare(b, 'tr'));
                if (state.selectedClass && !classes.includes(state.selectedClass)) {
                    state.selectedClass = '';
                }
                el.classFilter.innerHTML = optionMarkup('', 'Tüm sınıflar') + classes.map(item => optionMarkup(item)).join('');
                el.classFilter.value = state.selectedClass;
                el.classFilter.disabled = classes.length === 0;
            }

            function populateLessonFilter() {
                const lessons = uniqueSorted(filteredByCategory(state.allRecords).map(record => normalizeText(record.ders)));
                if (state.selectedLesson && !lessons.includes(state.selectedLesson)) {
                    state.selectedLesson = '';
                }
                el.lessonFilter.innerHTML = optionMarkup('', 'Tüm dersler') + lessons.map(item => optionMarkup(item)).join('');
                el.lessonFilter.value = state.selectedLesson;
                el.lessonFilter.disabled = lessons.length === 0;
            }

            function normalizeLesson(value) {
                return String(value || '').toLocaleUpperCase('tr-TR');
            }

            function sortByKnownOrder(items, order) {
                const index = new Map(order.map((item, i) => [item, i]));
                return [...items].sort((a, b) => {
                    const ai = index.has(a) ? index.get(a) : 999;
                    const bi = index.has(b) ? index.get(b) : 999;
                    return ai - bi || a.localeCompare(b, 'tr');
                });
            }

            function sinifSortKey(value) {
                const match = String(value || '').match(/(\d+)/);
                return match ? parseInt(match[1], 10) : 99;
            }

            function splitLines(text, maxChars, maxLines) {
                const words = String(text || '').split(/\s+/).filter(Boolean);
                const lines = [];
                let current = '';
                words.forEach(word => {
                    if (lines.length >= maxLines) return;
                    const next = current ? `${current} ${word}` : word;
                    if (next.length <= maxChars) {
                        current = next;
                    } else {
                        if (current) lines.push(current);
                        current = word;
                    }
                });
                if (current && lines.length < maxLines) lines.push(current);
                return lines.length ? lines : [String(text || '').slice(0, maxChars)];
            }

            function compactLines(text, maxChars, maxLines) {
                const words = String(text || '').split(/\s+/).filter(Boolean);
                const lines = [];
                let current = '';
                let overflow = false;

                for (const word of words) {
                    const next = current ? `${current} ${word}` : word;
                    if (next.length <= maxChars) {
                        current = next;
                        continue;
                    }

                    if (current) {
                        lines.push(current);
                        current = word;
                    } else {
                        lines.push(word.slice(0, Math.max(1, maxChars - 1)));
                        current = '';
                    }

                    if (lines.length >= maxLines) {
                        overflow = true;
                        break;
                    }
                }

                if (!overflow && current) lines.push(current);
                const limited = lines.slice(0, maxLines);
                if ((overflow || lines.length > maxLines) && limited.length) {
                    const last = limited.length - 1;
                    limited[last] = `${limited[last].slice(0, Math.max(1, maxChars - 1))}.`;
                }
                return limited.length ? limited : [String(text || '').slice(0, maxChars)];
            }

            function appendMultilineText(parent, lines, lineHeight) {
                const text = parent.append('text').attr('text-anchor', 'middle');
                const offset = -((lines.length - 1) * lineHeight) / 2;
                lines.forEach((line, index) => {
                    text.append('tspan')
                        .attr('x', 0)
                        .attr('dy', index === 0 ? offset : lineHeight)
                        .text(line);
                });
                return text;
            }

            function recordMatchesFilter(record) {
                if (!state.filter) return true;
                if (state.filterType === 'ana') return (record.anaProfiller || []).includes(state.filter);
                return normalizeLesson(record.ders) === state.filter;
            }

            function getFilteredRecords() {
                return state.records.filter(recordMatchesFilter);
            }

            function buildState(records) {
                state.records = records.map(record => ({
                    sinif: record.sinif,
                    ders: normalizeLesson(record.ders),
                    dersLabel: record.ders,
                    unite: record.unite,
                    anaProfiller: record.anaProfiller || [],
                    destekProfiller: record.destekProfiller || []
                }));

                state.profiles = profileOrder.filter(profile => state.records.some(record => record.anaProfiller.includes(profile)));
                uniqueSorted(state.records.flatMap(record => record.anaProfiller)).forEach(profile => {
                    if (!state.profiles.includes(profile)) state.profiles.push(profile);
                });
                state.lessons = sortByKnownOrder(uniqueSorted(state.records.map(record => record.ders)), lessonOrder);
                state.themes = uniqueSorted(state.records.map(record => record.unite));
                state.supportProfiles = profileOrder.filter(profile => state.records.some(record => record.destekProfiller.includes(profile)));
                uniqueSorted(state.records.flatMap(record => record.destekProfiller)).forEach(profile => {
                    if (!state.supportProfiles.includes(profile)) state.supportProfiles.push(profile);
                });

                state.edgeCounts = new Map();
                state.records.forEach(record => {
                    record.anaProfiller.forEach(profile => {
                        const key = `${profile}|${record.ders}`;
                        state.edgeCounts.set(key, (state.edgeCounts.get(key) || 0) + 1);
                    });
                });
            }

            function nodeCount(type, key) {
                if (type === 'ana') return state.records.filter(record => record.anaProfiller.includes(key)).length;
                return state.records.filter(record => record.ders === key).length;
            }

            function setFilter(type, key, label) {
                state.filterType = type;
                state.filter = key;
                state.filterLabel = label;
                el.badge.textContent = label;
                renderNetwork();
                renderMatrix();
            }

            function clearFilter() {
                state.filterType = null;
                state.filter = null;
                state.filterLabel = 'Genel toplam';
                el.badge.textContent = state.filterLabel;
                renderNetwork();
                renderMatrix();
            }

            function linkPath(source, target) {
                const sx = source.x;
                const sy = source.y + source.r;
                const tx = target.x;
                const ty = target.y - target.r;
                const midY = (sy + ty) / 2;
                return `M${sx},${sy} C${sx},${midY} ${tx},${midY} ${tx},${ty}`;
            }

            function renderNetwork() {
                const width = Math.max(320, el.networkPanel.clientWidth);
                const height = Math.max(520, el.networkPanel.clientHeight);
                const margin = { top: 64, right: 18, bottom: 78, left: 18 };
                const innerW = width - margin.left - margin.right;
                const innerH = height - margin.top - margin.bottom;
                const anaR = Math.max(22, Math.min(28, innerW / Math.max(state.profiles.length * 2.4, 1)));
                const lessonR = Math.max(24, Math.min(32, innerW / Math.max(state.lessons.length * 2.3, 1)));

                const anaNodes = state.profiles.map((profile, index) => ({
                    key: profile,
                    label: profile,
                    type: 'ana',
                    r: anaR,
                    x: (innerW / (state.profiles.length + 1)) * (index + 1),
                    y: anaR + 6,
                    count: nodeCount('ana', profile)
                }));
                const lessonNodes = state.lessons.map((lesson, index) => ({
                    key: lesson,
                    label: lessonDisplay.get(lesson) || lesson.toLocaleLowerCase('tr-TR'),
                    type: 'lesson',
                    r: lessonR,
                    x: (innerW / (state.lessons.length + 1)) * (index + 1),
                    y: innerH - lessonR - 8,
                    count: nodeCount('lesson', lesson)
                }));
                const allNodes = [...anaNodes, ...lessonNodes];
                const nodeByKey = new Map(allNodes.map(node => [`${node.type}|${node.key}`, node]));
                const activeLinks = Array.from(state.edgeCounts.entries()).map(([key, value]) => {
                    const [profile, lesson] = key.split('|');
                    return {
                        source: nodeByKey.get(`ana|${profile}`),
                        target: nodeByKey.get(`lesson|${lesson}`),
                        value
                    };
                }).filter(link => link.source && link.target);

                const svg = el.networkSvg.attr('width', width).attr('height', height);
                svg.selectAll('*').remove();

                const defs = svg.append('defs');
                defs.append('marker')
                    .attr('id', 'matrixArrow')
                    .attr('viewBox', '0 -5 10 10')
                    .attr('refX', 22)
                    .attr('refY', 0)
                    .attr('markerWidth', 6)
                    .attr('markerHeight', 6)
                    .attr('orient', 'auto')
                    .append('path')
                    .attr('d', 'M0,-5L10,0L0,5')
                    .attr('fill', '#263238');

                svg.append('rect')
                    .attr('width', width)
                    .attr('height', height)
                    .attr('fill', 'transparent')
                    .on('click', clearFilter);

                const g = svg.append('g').attr('transform', `translate(${margin.left},${margin.top})`);
                g.append('text')
                    .attr('class', 'network-section-title ana')
                    .attr('x', innerW / 2)
                    .attr('y', -22)
                    .text('Ana Profiller');
                g.append('text')
                    .attr('class', 'network-section-title lesson')
                    .attr('x', innerW / 2)
                    .attr('y', innerH + 48)
                    .text('Dersler');

                const linksBg = [];
                anaNodes.forEach(source => {
                    lessonNodes.forEach(target => linksBg.push({ source, target }));
                });

                g.append('g').selectAll('path')
                    .data(linksBg)
                    .join('path')
                    .attr('class', 'network-link-bg')
                    .attr('d', link => linkPath(link.source, link.target));

                g.append('g').selectAll('path')
                    .data(activeLinks)
                    .join('path')
                    .attr('class', link => {
                        const active = !state.filter ||
                            (state.filterType === 'ana' && link.source.key === state.filter) ||
                            (state.filterType === 'ders' && link.target.key === state.filter);
                        return `network-link${active ? ' is-highlight' : ' is-dimmed'}`;
                    })
                    .attr('d', link => linkPath(link.source, link.target))
                    .attr('marker-end', 'url(#matrixArrow)');

                const nodeGroups = g.append('g').selectAll('g')
                    .data(allNodes)
                    .join('g')
                    .attr('class', node => {
                        const selected = state.filter && state.filter === node.key && ((state.filterType === 'ana' && node.type === 'ana') || (state.filterType === 'ders' && node.type === 'lesson'));
                        let dimmed = false;
                        if (state.filter && !selected) {
                            dimmed = state.filterType === 'ana'
                                ? node.type === 'lesson' && !state.edgeCounts.has(`${state.filter}|${node.key}`)
                                : node.type === 'ana' && !state.edgeCounts.has(`${node.key}|${state.filter}`);
                        }
                        return `network-node ${node.type}${selected ? ' is-selected' : ''}${dimmed ? ' is-dimmed' : ''}`;
                    })
                    .attr('transform', node => `translate(${node.x},${node.y})`)
                    .on('click', (event, node) => {
                        event.stopPropagation();
                        setFilter(node.type === 'ana' ? 'ana' : 'ders', node.key, node.type === 'ana' ? node.label : node.label);
                    });

                nodeGroups.append('circle')
                    .attr('r', node => node.r)
                    .attr('fill', node => node.type === 'ana' ? '#d92d20' : '#bfdbfe')
                    .attr('stroke', node => node.type === 'ana' ? '#9f1f18' : '#1e63b6')
                    .attr('stroke-width', 1.6);

                nodeGroups.each(function(node) {
                    const lines = splitLines(node.label, node.type === 'ana' ? 12 : 11, 2);
                    appendMultilineText(d3.select(this), lines, node.type === 'ana' ? 8 : 7.5)
                        .attr('class', `network-label ${node.type === 'ana' ? 'ana' : 'lesson'}`);
                });

                nodeGroups.append('title')
                    .text(node => `${node.label}: ${node.count} kayıt`);
            }

            function buildMatrixData() {
                const filtered = getFilteredRecords();
                const source = new Map();
                const details = new Map();
                filtered.forEach(record => {
                    record.destekProfiller.forEach(profile => {
                        const key = `${record.unite}|${profile}`;
                        source.set(key, (source.get(key) || 0) + 1);
                        if (!details.has(key)) details.set(key, []);
                        details.get(key).push(record);
                    });
                });

                const themes = state.themes.filter(theme => !state.filter || state.supportProfiles.some(profile => source.has(`${theme}|${profile}`)));
                const cells = [];
                let max = 0;
                themes.forEach((theme, row) => {
                    state.supportProfiles.forEach((profile, col) => {
                        const value = source.get(`${theme}|${profile}`) || 0;
                        max = Math.max(max, value);
                        cells.push({ theme, profile, row, col, value, records: details.get(`${theme}|${profile}`) || [] });
                    });
                });
                return { themes, cells, max: Math.max(max, 1) };
            }

            function getThemeClasses(theme, records) {
                return uniqueSorted(records.filter(record => record.unite === theme).map(record => record.sinif))
                    .sort((a, b) => sinifSortKey(a) - sinifSortKey(b));
            }

            function renderMatrix() {
                const width = Math.max(320, el.matrixPanel.clientWidth);
                const { themes, cells, max } = buildMatrixData();
                const topPad = 112;
                const bottomPad = 24;
                const rightPad = 2;
                const rowLabelWidth = Math.max(150, Math.min(255, Math.round(width * 0.3)));
                const matrixWidth = Math.max(0, width - rowLabelWidth - rightPad);
                const cellWidth = matrixWidth / Math.max(state.supportProfiles.length, 1);
                const rowHeight = Math.max(34, Math.min(42, Math.round(cellWidth * 0.86)));
                const cellDrawWidth = Math.max(1, cellWidth - 2);
                const cellDrawHeight = Math.max(1, rowHeight - 2);
                const cellOffsetX = (cellWidth - cellDrawWidth) / 2;
                const cellOffsetY = (rowHeight - cellDrawHeight) / 2;
                const height = topPad + themes.length * rowHeight + bottomPad;
                const colorScale = d3.scaleSequential()
                    .domain([1, max])
                    .interpolator(t => d3.interpolateRgb('#fff5f0', '#fb9272', '#c5161d')(Math.min(1, Math.max(0, t))));

                el.legendMax.textContent = max;
                const svg = el.matrixSvg.attr('width', width).attr('height', height);
                svg.selectAll('*').remove();

                const g = svg.append('g');
                g.append('text')
                    .attr('class', 'matrix-axis-title row')
                    .attr('x', 0)
                    .attr('y', 20)
                    .text('ÜNİTE / ÖĞRENME ALANI / TEMA');

                g.append('text')
                    .attr('class', 'matrix-axis-title col')
                    .attr('x', rowLabelWidth + matrixWidth / 2)
                    .attr('y', 20)
                    .attr('text-anchor', 'middle')
                    .text('DESTEKLEYİCİ PROFİL');

                state.supportProfiles.forEach((profile, index) => {
                    const x = rowLabelWidth + index * cellWidth + cellWidth / 2;
                    const y = topPad - 8;
                    const label = g.append('text')
                        .attr('class', 'matrix-label col')
                        .attr('x', x)
                        .attr('y', y)
                        .attr('text-anchor', 'middle')
                        .attr('transform', `rotate(-34 ${x} ${y})`);
                    compactLines(profile, 12, 2).forEach((line, i) => {
                        label.append('tspan')
                            .attr('x', x)
                            .attr('dy', i === 0 ? 0 : 9)
                            .text(line);
                    });
                });

                themes.forEach((theme, index) => {
                    const centerY = topPad + index * rowHeight + rowHeight / 2;
                    const classes = getThemeClasses(theme, getFilteredRecords());
                    const text = classes.length ? `${theme} (${classes.join(', ')})` : theme;
                    const lines = compactLines(text, Math.max(18, Math.floor((rowLabelWidth - 14) / 5.3)), 2);
                    const firstLineY = centerY - ((lines.length - 1) * 4.5);
                    const label = g.append('text')
                        .attr('class', 'matrix-label row')
                        .attr('x', rowLabelWidth - 10)
                        .attr('y', firstLineY)
                        .attr('text-anchor', 'end');
                    lines.forEach((line, i) => {
                        label.append('tspan')
                            .attr('x', rowLabelWidth - 10)
                            .attr('dy', i === 0 ? 0 : 9)
                            .text(line);
                    });
                });

                const cellGroups = g.selectAll('.matrix-cell')
                    .data(cells)
                    .join('g')
                    .attr('class', cell => `matrix-cell${cell.value ? ' has-value' : ''}`)
                    .attr('transform', cell => `translate(${rowLabelWidth + cell.col * cellWidth + cellOffsetX},${topPad + cell.row * rowHeight + cellOffsetY})`)
                    .on('click', (event, cell) => {
                        event.stopPropagation();
                        if (cell.value) openDetailModal(cell);
                    });

                cellGroups.append('rect')
                    .attr('width', cellDrawWidth)
                    .attr('height', cellDrawHeight)
                    .attr('rx', 2)
                    .attr('fill', cell => cell.value ? colorScale(cell.value) : '#f8fafc');

                cellGroups.append('text')
                    .attr('class', cell => `matrix-value${cell.value / max > 0.68 ? ' on-dark' : ''}`)
                    .attr('x', cellDrawWidth / 2)
                    .attr('y', cellDrawHeight / 2 + 4)
                    .text(cell => cell.value);
            }

            function openDetailModal(cell) {
                const seen = new Set();
                const details = [];
                cell.records.forEach(record => {
                    const key = `${record.sinif}|${record.ders}|${record.anaProfiller.join(',')}`;
                    if (seen.has(key)) return;
                    seen.add(key);
                    details.push(record);
                });
                details.sort((a, b) => sinifSortKey(a.sinif) - sinifSortKey(b.sinif) || a.ders.localeCompare(b.ders, 'tr'));

                const classes = uniqueSorted(details.map(record => record.sinif)).sort((a, b) => sinifSortKey(a) - sinifSortKey(b));
                el.modalTitle.textContent = `${cell.theme} × ${cell.profile}`;
                el.modalSubtitle.textContent = `${cell.value} ilişki${classes.length ? ' · Sınıflar: ' + classes.join(', ') : ''}`;
                el.modalRows.innerHTML = details.length
                    ? details.map(record => `
                        <tr>
                            <td>${escapeHtml(record.sinif || '-')}</td>
                            <td>${escapeHtml(record.ders || '-')}</td>
                            <td>${escapeHtml(record.anaProfiller.join(', ') || '-')}</td>
                            <td>${escapeHtml(cell.profile)}</td>
                        </tr>`).join('')
                    : '<tr><td colspan="4">Detay bulunamadı.</td></tr>';
                el.modal.classList.add('is-open');
                document.body.style.overflow = 'hidden';
            }

            function closeDetailModal() {
                el.modal.classList.remove('is-open');
                document.body.style.overflow = '';
            }

            function renderStats() {
                el.stats.innerHTML = `
                    <span class="matrix-stat">${state.records.length} kayıt</span>
                    <span class="matrix-stat">${state.profiles.length} ana profil</span>
                    <span class="matrix-stat">${state.lessons.length} ders</span>
                    <span class="matrix-stat">${state.themes.length} tema</span>
                    <span class="matrix-stat">${state.supportProfiles.length} destekleyici</span>`;
            }

            function renderAll() {
                renderStats();
                renderNetwork();
                renderMatrix();
            }

            function renderFilteredState() {
                clearFilterState();
                buildState(filteredRecords());
                renderAll();
                el.status.textContent = state.records.length
                    ? 'Matris diagramı hazır.'
                    : 'Seçilen filtrelerde kayıt bulunamadı.';
            }

            function clearFilterState() {
                state.filterType = null;
                state.filter = null;
                state.filterLabel = 'Genel toplam';
                el.badge.textContent = state.filterLabel;
            }

            el.clear.addEventListener('click', clearFilter);
            el.categoryFilter.addEventListener('change', () => {
                state.selectedCategory = el.categoryFilter.value;
                state.selectedLesson = '';
                state.selectedClass = '';
                populateLessonFilter();
                populateClassFilter(state.allRecords);
                renderFilteredState();
            });
            el.lessonFilter.addEventListener('change', () => {
                state.selectedLesson = el.lessonFilter.value;
                state.selectedClass = '';
                populateClassFilter(state.allRecords);
                renderFilteredState();
            });
            el.classFilter.addEventListener('change', () => {
                state.selectedClass = el.classFilter.value;
                renderFilteredState();
            });
            el.modalClose.addEventListener('click', closeDetailModal);
            el.modal.addEventListener('click', event => {
                if (event.target === el.modal) closeDetailModal();
            });
            document.addEventListener('keydown', event => {
                if (event.key === 'Escape') closeDetailModal();
            });
            window.addEventListener('resize', () => {
                clearTimeout(window.__matrixResizeTimer);
                window.__matrixResizeTimer = setTimeout(renderAll, 160);
            });

            window.OgrenciProfiliStore.loadData(dataSourceUrl)
                .then(payload => {
                    state.allRecords = payload.records || [];
                    populateCategoryFilter(state.allRecords);
                    populateLessonFilter();
                    populateClassFilter(state.allRecords);
                    buildState(filteredRecords());
                    if (!state.records.length) throw new Error('Ham veri JSON dosyasında kayıt bulunamadı.');
                    el.loading.style.display = 'none';
                    el.status.textContent = 'Matris diagramı hazır.';
                    renderAll();
                })
                .catch(error => {
                    el.loading.textContent = error.message;
                    el.status.textContent = 'Matris diagramı yüklenemedi.';
                });
        })();
    </script>
}
